{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "version": "0.1.0",
  "identifier": "com.workbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "待办工作台",
        "width": 900,
        "height": 620,
        "minWidth": 600,
        "minHeight": 420,
        "resizable": true,
        "alwaysOnTop": false,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
